{
  "name": "dsh-window",
  "version": "0.0.4",
  "description": "Floating Markdown note card for the DeepSeek Harness web GUI: per-session multi-note spaces, long-press highlighting with colours and your own remarks, reading-position memory, per-note git history, Mermaid rendering, and 23 note_* model tools that keep the agent's context cost low.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "license": "MIT",
  "author": "bbtssama",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "note",
    "markdown",
    "typora",
    "floating-panel",
    "mermaid",
    "annotation",
    "llm"
  ],
  "homepage": "https://github.com/bbtssama/dsh-window#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bbtssama/dsh-window.git"
  },
  "bugs": {
    "url": "https://github.com/bbtssama/dsh-window/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "mermaid": "12.0.0"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-tools": "*"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-tools": {
      "optional": true
    }
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": []
    }
  }
}
